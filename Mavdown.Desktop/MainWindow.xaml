<Window x:Class="Mavdown.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Mavdown.Desktop.Models"
        mc:Ignorable="d"
        Title="Maven Downloader v1.3.0" 
        Height="880" Width="1420"
        MinHeight="750" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBgMaster}"
        Foreground="{DynamicResource BrushTextTitle}"
        FontFamily="Segoe UI, Inter, Arial"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 1. Left Sidebar Navigation (260px) -->
            <ColumnDefinition Width="260" />
            <!-- 2. Main Workspace -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Canvas background texture layer (Behind everything) -->
        <Rectangle Grid.Column="0" Grid.ColumnSpan="2" IsHitTestVisible="False" Fill="{DynamicResource BrushNoiseOverlay}" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 1. LEFT SIDEBAR NAVIGATION (ui/sidebar.py layout)             -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{DynamicResource BrushSidebarBg}" BorderBrush="{DynamicResource BrushBorderDark}" BorderThickness="0,0,1,0">
            <Grid>
                <!-- Subtle noise for sidebar surface -->
                <Rectangle IsHitTestVisible="False" Fill="{DynamicResource BrushNoiseOverlay}" />
                <Grid Margin="16,18,16,16">
                <Grid.RowDefinitions>
                    <!-- Brand -->
                    <RowDefinition Height="Auto" />
                    <!-- Navigasi Utama -->
                    <RowDefinition Height="Auto" />
                    <!-- Preset Cepat -->
                    <RowDefinition Height="Auto" />
                    <!-- Spacer -->
                    <RowDefinition Height="*" />
                    <!-- Bottom System Status Card -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ── App Brand & Logo ── -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" Background="{DynamicResource BrushGatefoldSegmentBg}" CornerRadius="8" Margin="0,0,10,0" ClipToBounds="True">
                            <Image x:Name="AppLogoImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MAVDOWN" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource BrushTextTitle}" />
                                <Border Background="{DynamicResource BrushNavActiveBg}" CornerRadius="6" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="v1.3.0" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushNavActiveFg}" />
                                </Border>
                            </StackPanel>
                            <Border x:Name="EngineStatusBadge" Background="#064E3B" CornerRadius="6" Padding="6,1" Margin="0,3,0,0" HorizontalAlignment="Left">
                                <TextBlock x:Name="EngineStatusText" Text="MULTI-TIER ENGINE" FontSize="9" FontWeight="Bold" Foreground="#34D399" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource BrushBorderDark}" Margin="0,14,0,0" />
                </StackPanel>

                <!-- ── Navigasi Utama (5 Tabs) ── -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="NAVIGASI UTAMA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="4,0,0,6" />

                    <!-- Tab Studio -->
                    <Border x:Name="TabStudioBtn" Background="{DynamicResource BrushNavActiveBg}" CornerRadius="8" Padding="12,10" Margin="0,2" Cursor="Hand" MouseDown="OnTabStudioClick">
                        <TextBlock x:Name="TxtNavStudio" Text="Studio Unduh" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushNavActiveFg}" />
                    </Border>

                    <!-- Tab Antrean -->
                    <Border x:Name="TabQueueBtn" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="0,2" Cursor="Hand" MouseDown="OnTabQueueClick">
                        <TextBlock x:Name="TxtNavQueue" Text="Antrean Batch" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                    </Border>

                    <!-- Tab Riwayat -->
                    <Border x:Name="TabHistoryBtn" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="0,2" Cursor="Hand" MouseDown="OnTabHistoryClick">
                        <TextBlock x:Name="TxtNavHistory" Text="Riwayat Unduh" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                    </Border>

                    <!-- Tab Log -->
                    <Border x:Name="TabLogBtn" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="0,2" Cursor="Hand" MouseDown="OnTabLogClick">
                        <TextBlock x:Name="TxtNavLog" Text="Konsol Log" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                    </Border>

                    <!-- Tab Pengaturan -->
                    <Border x:Name="TabSettingsBtn" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="0,2" Cursor="Hand" MouseDown="OnTabSettingsClick">
                        <TextBlock x:Name="TxtNavSettings" Text="Pengaturan" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                    </Border>

                    <Border Height="1" Background="{DynamicResource BrushBorderDark}" Margin="0,10,0,0" />
                </StackPanel>

                <!-- ── Preset Cepat (Quick Presets) ── -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="PRESET CEPAT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="4,0,0,6" />

                    <Button Content="Super Quality" Background="#4338CA" Foreground="#F3F4F6" Height="32" Margin="0,2" Style="{StaticResource StdButton}" HorizontalContentAlignment="Left" Padding="12,0" Click="OnPresetSuperQualityClick" />
                    <Button Content="Musik MP3" Background="#6D28D9" Foreground="#F3F4F6" Height="32" Margin="0,2" Style="{StaticResource StdButton}" HorizontalContentAlignment="Left" Padding="12,0" Click="OnPresetMusikMp3Click" />
                    <Button Content="Hemat Data" Background="#0E7490" Foreground="#F3F4F6" Height="32" Margin="0,2" Style="{StaticResource StdButton}" HorizontalContentAlignment="Left" Padding="12,0" Click="OnPresetHematDataClick" />
                    <Button Content="Podcast" Background="#047857" Foreground="#F3F4F6" Height="32" Margin="0,2" Style="{StaticResource StdButton}" HorizontalContentAlignment="Left" Padding="12,0" Click="OnPresetPodcastClick" />

                    <TextBlock Text="Preset mengatur format, codec, dan resolusi secara otomatis." FontSize="9" Foreground="{DynamicResource BrushTextDim}" TextWrapping="Wrap" Margin="4,6,0,0" />
                </StackPanel>

                <!-- ── Bottom System Status Card ── -->
                <Border Grid.Row="4" Background="{DynamicResource BrushGatefoldInner}" BorderBrush="{DynamicResource BrushGatefoldInnerBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Lokasi Simpan:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,3" />
                        <TextBlock x:Name="SidebarPathText" Text="Downloads\Mavdown" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextAccent}" TextWrapping="Wrap" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Ubah" Height="28" Margin="0,0,3,0" Style="{StaticResource GhostButton}" Click="OnSelectFolderClick" />
                            <Button Grid.Column="1" Content="Buka" Height="28" Margin="3,0,0,0" Style="{StaticResource GhostButton}" Click="OnOpenFolderClick" />
                        </Grid>

                        <Button x:Name="SidebarUpdateBtn" Content="Update yt-dlp" Height="30" Style="{StaticResource AmberButton}" Click="OnUpdateYtdlpClick" />
                    </StackPanel>
                </Border>
            </Grid>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 2. MAIN WORKSPACE (Right Area)                                 -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <!-- Top Universal Command Bar -->
                <RowDefinition Height="Auto" />
                <!-- Views Container -->
                <RowDefinition Height="*" />
                <!-- Bottom Live Progress & Telemetry Dock -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ── Top Universal Command Bar (Gatefold Gradient Header) ── -->
            <Border x:Name="TopCommandBar" Grid.Row="0" Background="{DynamicResource BrushGatefoldCardBg}" BorderBrush="{DynamicResource BrushGatefoldBorder}" BorderThickness="1" CornerRadius="14" Margin="0,0,0,14" Padding="14,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.35" />
                </Border.Effect>
                <Grid>
                    <Rectangle IsHitTestVisible="False" Fill="{DynamicResource BrushNoiseOverlay}" Margin="-14,-10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- URL Input (with embedded X button) -->
                            <ColumnDefinition Width="*" />
                            <!-- Tempel -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Cek Info -->
                            <ColumnDefinition Width="Auto" />
                            <!-- MULAI UNDUH -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Platform Pill Badge -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- URL Input Box with Embedded Clear X Button -->
                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <TextBox x:Name="UrlInput" 
                                     Height="44" 
                                     Background="{DynamicResource BrushGatefoldInner}" 
                                     BorderBrush="{DynamicResource BrushGatefoldInnerBorder}" 
                                     BorderThickness="1" 
                                     Foreground="{DynamicResource BrushTextTitle}" 
                                     FontSize="13" 
                                     Padding="14,10,40,10" 
                                     VerticalAlignment="Center"
                                     KeyDown="OnUrlInputKeyDown"
                                     TextChanged="OnUrlInputTextChanged" />

                            <TextBlock x:Name="UrlPlaceholder" 
                                       Text="Tempelkan link YouTube, TikTok, Instagram, Twitter/X, Douyin, Pinterest, Pixiv..." 
                                       Foreground="{DynamicResource BrushTextDim}" 
                                       FontSize="13" 
                                       Padding="16,12,40,12" 
                                       VerticalAlignment="Center" 
                                       IsHitTestVisible="False" />

                            <!-- Inline Clear URL Button inside input link -->
                            <Button x:Name="BtnClearUrl" 
                                    Content="X" 
                                    Width="26" 
                                    Height="26" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Center" 
                                    Margin="0,0,10,0" 
                                    Foreground="{DynamicResource BrushTextDim}" 
                                    FontSize="11" 
                                    FontWeight="Bold" 
                                    Cursor="Hand" 
                                    Focusable="False"
                                    ToolTip="Hapus URL"
                                    Click="OnClearUrlClick" 
                                    Visibility="Collapsed">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Width="26" Height="26" CornerRadius="13" Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushBorderLight}" />
                                                <Setter Property="Foreground" Value="{DynamicResource BrushTextTitle}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushGatefoldCardBg}" />
                                                <Setter Property="Foreground" Value="{DynamicResource BrushAccentIndigo}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Tempel Button -->
                        <Button Grid.Column="1" Content="Tempel" Width="76" Height="44" Margin="0,0,8,0" Style="{StaticResource StdButton}" Click="OnPasteClick" />

                        <!-- Cek Info Button -->
                        <Button Grid.Column="2" Content="Cek Info" Width="104" Height="44" Margin="0,0,8,0" Style="{StaticResource IndigoButton}" Click="OnInspectClick" />

                        <!-- Primary Download Button -->
                        <Button x:Name="BtnDownload" Grid.Column="3" Content="MULAI UNDUH" Width="144" Height="44" Style="{StaticResource EmeraldButton}" Click="OnDownloadClick" />

                        <!-- Platform Pill Badge -->
                        <Border x:Name="PlatformBadge" Grid.Column="4" CornerRadius="8" Background="#1C2744" BorderBrush="#2E3F6E" BorderThickness="1" Margin="8,0,0,0" Padding="14,6" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="PlatformBadgeText" Text="TIKTOK" FontSize="11" FontWeight="Bold" Foreground="#F3F4F6" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── Center Views Container ── -->
            <Grid Grid.Row="1">

                <!-- ════ TAB 1: STUDIO UNDUH (Gatefold Layout Inspired) ════ -->
                <Grid x:Name="StudioPanel" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Media Inspector (50% Studio Width) -->
                        <ColumnDefinition Width="*" MinWidth="440" />
                        <!-- Right: Studio Configuration (50% Studio Width) -->
                        <ColumnDefinition Width="*" MinWidth="440" />
                    </Grid.ColumnDefinitions>

                    <!-- ── LEFT: MEDIA INSPECTOR (Gatefold Album Art & Info Stage) ── -->
                    <Border x:Name="MediaInspectorCard" Grid.Column="0" Background="{DynamicResource BrushGatefoldCardBg}" BorderBrush="{DynamicResource BrushGatefoldBorder}" BorderThickness="1" CornerRadius="16" Margin="0,0,16,0" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.45" />
                        </Border.Effect>
                        <Grid>
                            <Rectangle IsHitTestVisible="False" Fill="{DynamicResource BrushNoiseOverlay}" Margin="-20" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Eyebrow Tag Row (Gatefold Style) -->
                                <Grid Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Gatefold .eq signature equalizer glyph (3 bars) -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Border x:Name="EqBar1" Width="2.5" Height="7" CornerRadius="1" Background="{DynamicResource BrushAccentIndigo}" Margin="0,0,2,0" VerticalAlignment="Bottom" />
                                            <Border x:Name="EqBar2" Width="2.5" Height="12" CornerRadius="1" Background="{DynamicResource BrushAccentIndigo}" Margin="0,0,2,0" VerticalAlignment="Bottom" />
                                            <Border x:Name="EqBar3" Width="2.5" Height="5" CornerRadius="1" Background="{DynamicResource BrushAccentIndigo}" VerticalAlignment="Bottom" />
                                        </StackPanel>
                                        <TextBlock Text="INSPEKSI MEDIA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccentIndigo}" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource BrushGatefoldSegmentBg}" BorderBrush="{DynamicResource BrushBorderDark}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="MetaPlatformText" Text="MEDIA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccentIndigo}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="MetaDateText" Text="" FontSize="11" Foreground="{DynamicResource BrushTextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Artwork Stage Box (Gatefold Ambient Halo & Rounded Vinyl Frame) -->
                                <Border x:Name="ArtworkFrameBorder" Height="310" CornerRadius="14" Margin="0,0,0,16">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="ArtworkGlowEffect" BlurRadius="68" ShadowDepth="0" Direction="0" Color="#657383" Opacity="0.85" />
                                    </Border.Effect>
                                    <Border CornerRadius="14" ClipToBounds="True" Background="{DynamicResource BrushGatefoldInner}" BorderBrush="{DynamicResource BrushGatefoldInnerBorder}" BorderThickness="1">
                                        <Grid>
                                            <!-- Sleek placeholder when empty -->
                                            <StackPanel x:Name="ArtworkPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="Menunggu URL atau Inspeksi Media" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextTitle}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Tempelkan tautan media di atas untuk memuat pratinjau studio" FontSize="11" Foreground="{DynamicResource BrushTextDim}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                            </StackPanel>

                                            <!-- Image element (High Quality scaling) -->
                                            <Image x:Name="MediaThumbnail" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>
                                </Border>

                                <!-- Media Title (Gatefold Bold Hero Typography) -->
                                <TextBlock x:Name="MediaTitleText" 
                                           Text="Judul media akan muncul di sini setelah memasukkan tautan." 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           Foreground="#F9FAFB" 
                                           TextWrapping="Wrap" 
                                           TextAlignment="Left" 
                                           Margin="0,0,0,4" />

                                <!-- Creator / Channel (Semi-Bold Accent) -->
                                <TextBlock x:Name="MetaChannelText" 
                                           Text="Kreator: -" 
                                           FontSize="13" 
                                           FontWeight="SemiBold" 
                                           Foreground="#818CF8" 
                                           Margin="0,0,0,12" />

                                <!-- Gatefold Stats Bar (Clean 3-Column Glass Card) -->
                                <Border Background="{DynamicResource BrushGatefoldInner}" BorderBrush="{DynamicResource BrushGatefoldInnerBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Duration -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="MetaDurationLabel" Text="DURASI" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,2" />
                                            <TextBlock x:Name="MetaDurationText" Text="-" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTitle}" />
                                        </StackPanel>

                                        <!-- Divider -->
                                        <Border Grid.Column="1" Width="1" Background="{DynamicResource BrushBorderDark}" Margin="10,2" />

                                        <!-- Views -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="MetaViewsLabel" Text="VIEWS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,2" />
                                            <TextBlock x:Name="MetaViewsText" Text="-" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTitle}" />
                                        </StackPanel>

                                        <!-- Divider -->
                                        <Border Grid.Column="3" Width="1" Background="{DynamicResource BrushBorderDark}" Margin="10,2" />

                                        <!-- Likes -->
                                        <StackPanel Grid.Column="4">
                                            <TextBlock x:Name="MetaLikesLabel" Text="LIKES" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,2" />
                                            <TextBlock x:Name="MetaLikesText" Text="-" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTitle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Description Snippet -->
                                <TextBlock x:Name="MetaDescText" Text="" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,14" />

                                <!-- Quality & Format Badges (Frosted Pill Chips) -->
                                <TextBlock Text="KUALITAS &amp; FORMAT MEDIA TERSEDIA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,8" />
                                <WrapPanel x:Name="BadgesWrapPanel" Margin="0,0,0,4" />
                            </StackPanel>
                        </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- ── RIGHT: CONFIGURATION STUDIO (Gatefold Theme Unified) ── -->
                    <Border x:Name="ConfigStudioCard" Grid.Column="1" Background="{DynamicResource BrushGatefoldCardBg}" BorderBrush="{DynamicResource BrushGatefoldBorder}" BorderThickness="1" CornerRadius="16" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.45" />
                        </Border.Effect>
                        <Grid>
                            <Rectangle IsHitTestVisible="False" Fill="{DynamicResource BrushNoiseOverlay}" Margin="-20" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <!-- Section 1: Mode Switcher (Sleek Segmented Bar) -->
                                <Border Background="{DynamicResource BrushGatefoldInner}" BorderBrush="{DynamicResource BrushGatefoldInnerBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="PILIH MODE EKSTRAKSI" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,6" />
                                        <Border Background="{DynamicResource BrushGatefoldSegmentBg}" BorderBrush="{DynamicResource BrushBorderDark}" BorderThickness="1" CornerRadius="8" Padding="3" Height="40">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <RadioButton x:Name="RadioVideo" Grid.Column="0" Content="Video + Audio" IsChecked="True" Style="{StaticResource ModeSegmentButton}" GroupName="ModeExtract" Checked="OnModeSegmentChange" />
                                                <RadioButton x:Name="RadioAudio" Grid.Column="1" Content="Audio Saja (Musik)" Style="{StaticResource ModeSegmentButton}" GroupName="ModeExtract" Checked="OnModeSegmentChange" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Section 2: Format & Codec Options (Dynamic format_card) -->
                                <Border Background="{DynamicResource BrushGatefoldInner}" BorderBrush="{DynamicResource BrushGatefoldInnerBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="FormatTitleLabel" Text="PARAMETER FORMAT &amp; KUALITAS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,8" />

                                        <!-- 2A. SLIDE / UGOIRA OPTS (Khusus Album Foto Slide / Ugoira) -->
                                        <StackPanel x:Name="SlideOptsPanel" Visibility="Collapsed">
                                            <!-- Banner -->
                                            <Border Background="{DynamicResource BrushGatefoldSegmentBg}" CornerRadius="8" BorderBrush="{DynamicResource BrushBorderDark}" BorderThickness="1" Padding="14,12" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock x:Name="SlideBannerTitle" Text="MODE ALBUM SLIDE FOTO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentIndigo}" HorizontalAlignment="Left" />
                                                        <Border x:Name="SlideBadgeBox" Background="{DynamicResource BrushAccentIndigo}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                                                            <TextBlock x:Name="SlideBadgeLbl" Text="HD Original" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccentForeground}" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock x:Name="SlideStatusLbl" Text="MavDown akan mengunduh semua file gambar asli HD tanpa watermark ke subfolder album khusus beserta file musik BGM." FontSize="10" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Grid Details -->
                                            <Border Background="{DynamicResource BrushGatefoldSegmentBg}" BorderBrush="{DynamicResource BrushBorderDark}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock x:Name="SlidePCount" Grid.Row="0" Grid.Column="0" Text="Total: 2 Foto Slide" FontSize="11" Foreground="{DynamicResource BrushTextBody}" Margin="0,2" />
                                                    <TextBlock x:Name="SlidePFormat" Grid.Row="0" Grid.Column="1" Text="Format: JPEG HD (Lossless)" FontSize="11" Foreground="{DynamicResource BrushTextBody}" Margin="0,2" />
                                                    <TextBlock x:Name="SlidePRes" Grid.Row="1" Grid.Column="0" Text="Dimensi: Asli" FontSize="11" Foreground="{DynamicResource BrushTextBody}" Margin="0,2" />
                                                    <TextBlock x:Name="SlidePAudio" Grid.Row="1" Grid.Column="1" Text="Audio: Tanpa Musik" FontSize="11" Foreground="{DynamicResource BrushTextBody}" Margin="0,2" />
                                                </Grid>
                                            </Border>

                                            <!-- Ugoira Selector -->
                                            <StackPanel x:Name="UgoiraContainer" Visibility="Collapsed" Margin="0,4,0,4">
                                                <TextBlock Text="PILIH FORMAT HASIL ANIMASI:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RadioUgoiraMp4" Content="Video (MP4)" IsChecked="True" Style="{StaticResource SegmentRadioButton}" GroupName="GroupUgoira" Checked="OnUgoiraFormatChange" />
                                                    <RadioButton x:Name="RadioUgoiraGif" Content="Animasi (GIF)" Style="{StaticResource SegmentRadioButton}" GroupName="GroupUgoira" Checked="OnUgoiraFormatChange" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 2B. VIDEO OPTS (3 Kolom Container, Video Codec, Audio Codec + Baris Resolusi persis Tkinter) -->
                                        <StackPanel x:Name="VideoOptsPanel">
                                            <!-- Container Video (Full Width) -->
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="Container Video:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
                                                <Border Background="{DynamicResource BrushGatefoldSegmentBg}" BorderBrush="{DynamicResource BrushBorderDark}" BorderThickness="1" CornerRadius="8" Padding="2" Height="36">
                                                    <UniformGrid Rows="1" Columns="5">
                                                        <RadioButton x:Name="RadContAuto" Content="Auto" IsChecked="True" Style="{StaticResource SegmentRadioButton}" GroupName="GroupContainer" />
                                                        <RadioButton x:Name="RadContMp4" Content="MP4" Style="{StaticResource SegmentRadioButton}" GroupName="GroupContainer" />
                                                        <RadioButton x:Name="RadContMkv" Content="MKV" Style="{StaticResource SegmentRadioButton}" GroupName="GroupContainer" />
                                                        <RadioButton x:Name="RadContWebm" Content="WEBM" Style="{StaticResource SegmentRadioButton}" GroupName="GroupContainer" />
                                                        <RadioButton x:Name="RadContMov" Content="MOV" Style="{StaticResource SegmentRadioButton}" GroupName="GroupContainer" />
                                                    </UniformGrid>
                                                </Border>
                                            </StackPanel>

                                            <!-- Video Codec & Audio Codec (2 Kolom Rapi) -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.15*" />
                                                    <ColumnDefinition Width="0.85*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Col 0: Video Codec -->
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Video Codec:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
                                                    <Border Background="{DynamicResource BrushGatefoldSegmentBg}" BorderBrush="{DynamicResource BrushBorderDark}" BorderThickness="1" CornerRadius="8" Padding="2" Height="36">
                                                        <UniformGrid Rows="1" Columns="4">
                                                            <RadioButton x:Name="RadVCodecAuto" Content="Auto" IsChecked="True" Style="{StaticResource SegmentRadioButton}" GroupName="GroupVCodec" />
                                                            <RadioButton x:Name="RadVCodecH264" Content="H.264" Style="{StaticResource SegmentRadioButton}" GroupName="GroupVCodec" />
                                                            <RadioButton x:Name="RadVCodecVp9" Content="VP9" Style="{StaticResource SegmentRadioButton}" GroupName="GroupVCodec" />
                                                            <RadioButton x:Name="RadVCodecAv1" Content="AV1" Style="{StaticResource SegmentRadioButton}" GroupName="GroupVCodec" />
                                                        </UniformGrid>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Col 1: Audio Codec -->
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Audio Codec:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
                                                    <Border Background="{DynamicResource BrushGatefoldSegmentBg}" BorderBrush="{DynamicResource BrushBorderDark}" BorderThickness="1" CornerRadius="8" Padding="2" Height="36">
                                                        <UniformGrid Rows="1" Columns="3">
                                                            <RadioButton x:Name="RadACodecAuto" Content="Auto" IsChecked="True" Style="{StaticResource SegmentRadioButton}" GroupName="GroupACodec" />
                                                            <RadioButton x:Name="RadACodecM4a" Content="M4A" Style="{StaticResource SegmentRadioButton}" GroupName="GroupACodec" />
                                                            <RadioButton x:Name="RadACodecOpus" Content="Opus" Style="{StaticResource SegmentRadioButton}" GroupName="GroupACodec" />
                                                        </UniformGrid>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row 2: Kualitas / Resolusi Maksimal -->
                                            <StackPanel Margin="0,0,0,4">
                                                <TextBlock Text="Kualitas / Resolusi Maksimal:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
                                                <Border Background="{DynamicResource BrushGatefoldSegmentBg}" BorderBrush="{DynamicResource BrushBorderDark}" BorderThickness="1" CornerRadius="8" Padding="2" Height="38">
                                                    <UniformGrid Rows="1" Columns="7">
                                                        <RadioButton x:Name="RadResAuto" Content="Auto" IsChecked="True" Style="{StaticResource SegmentRadioButton}" GroupName="GroupRes" />
                                                        <RadioButton x:Name="RadRes4k" Content="4K" Style="{StaticResource SegmentRadioButton}" GroupName="GroupRes" />
                                                        <RadioButton x:Name="RadRes1440" Content="1440p" Style="{StaticResource SegmentRadioButton}" GroupName="GroupRes" />
                                                        <RadioButton x:Name="RadRes1080" Content="1080p" Style="{StaticResource SegmentRadioButton}" GroupName="GroupRes" />
                                                        <RadioButton x:Name="RadRes720" Content="720p" Style="{StaticResource SegmentRadioButton}" GroupName="GroupRes" />
                                                        <RadioButton x:Name="RadRes480" Content="480p" Style="{StaticResource SegmentRadioButton}" GroupName="GroupRes" />
                                                        <RadioButton x:Name="RadRes360" Content="360p" Style="{StaticResource SegmentRadioButton}" GroupName="GroupRes" />
                                                    </UniformGrid>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 2C. AUDIO OPTS (Khusus Audio Saja - Sleek Segmented Buttons) -->
                                        <StackPanel x:Name="AudioOptsPanel" Visibility="Collapsed">
                                            <!-- Row 1: Format File Audio -->
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="Format File Audio:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
                                                <Border Background="{DynamicResource BrushGatefoldSegmentBg}" BorderBrush="{DynamicResource BrushBorderDark}" BorderThickness="1" CornerRadius="8" Padding="2" Height="36">
                                                    <UniformGrid Rows="1" Columns="5">
                                                        <RadioButton x:Name="RadAudioMp3" Content="MP3" IsChecked="True" Style="{StaticResource SegmentRadioButton}" GroupName="GroupAudioFmt" />
                                                        <RadioButton x:Name="RadAudioM4a" Content="M4A" Style="{StaticResource SegmentRadioButton}" GroupName="GroupAudioFmt" />
                                                        <RadioButton x:Name="RadAudioFlac" Content="FLAC" Style="{StaticResource SegmentRadioButton}" GroupName="GroupAudioFmt" />
                                                        <RadioButton x:Name="RadAudioWav" Content="WAV" Style="{StaticResource SegmentRadioButton}" GroupName="GroupAudioFmt" />
                                                        <RadioButton x:Name="RadAudioOpus" Content="OPUS" Style="{StaticResource SegmentRadioButton}" GroupName="GroupAudioFmt" />
                                                    </UniformGrid>
                                                </Border>
                                            </StackPanel>

                                            <!-- Row 2: Kualitas Bitrate Audio -->
                                            <StackPanel Margin="0,0,0,4">
                                                <TextBlock Text="Kualitas Bitrate Audio:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
                                                <Border Background="{DynamicResource BrushGatefoldSegmentBg}" BorderBrush="{DynamicResource BrushBorderDark}" BorderThickness="1" CornerRadius="8" Padding="2" Height="36">
                                                    <UniformGrid Rows="1" Columns="4">
                                                        <RadioButton x:Name="RadBitrate320" Content="320 kbps" IsChecked="True" Style="{StaticResource SegmentRadioButton}" GroupName="GroupBitrate" />
                                                        <RadioButton x:Name="RadBitrate256" Content="256 kbps" Style="{StaticResource SegmentRadioButton}" GroupName="GroupBitrate" />
                                                        <RadioButton x:Name="RadBitrate192" Content="192 kbps" Style="{StaticResource SegmentRadioButton}" GroupName="GroupBitrate" />
                                                        <RadioButton x:Name="RadBitrate128" Content="128 kbps" Style="{StaticResource SegmentRadioButton}" GroupName="GroupBitrate" />
                                                    </UniformGrid>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Section 3: Subtitle & Lirik Otomatis (sec_sub) -->
                                <!-- ATURAN: Hanya muncul jika BUKAN mode slide foto! -->
                                <Border x:Name="SecSubPanel" Background="{DynamicResource BrushGatefoldInner}" BorderBrush="{DynamicResource BrushGatefoldInnerBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="LangLabel" Text="SUBTITLE &amp; LIRIK OTOMATIS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,6" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>

                                            <ComboBox x:Name="ComboSubsLang" Grid.Column="0" FontSize="11" Height="34" SelectionChanged="OnLangPresetChange">
                                                <ComboBoxItem Content="Indonesia &amp; English" IsSelected="True" />
                                                <ComboBoxItem Content="Bahasa Indonesia" />
                                                <ComboBoxItem Content="English" />
                                                <ComboBoxItem Content="Jepang (Japanese)" />
                                                <ComboBoxItem Content="Cina (Chinese)" />
                                                <ComboBoxItem Content="Korea (Korean)" />
                                                <ComboBoxItem Content="Spanyol (Spanish)" />
                                                <ComboBoxItem Content="Semua Bahasa (All)" />
                                                <ComboBoxItem Content="Custom / Manual" />
                                            </ComboBox>

                                            <TextBlock Grid.Column="1" Text="ISO:" FontSize="10" Foreground="{DynamicResource BrushTextDim}" VerticalAlignment="Center" Margin="8,0,4,0" />

                                            <TextBox x:Name="SubsLangEntry" Grid.Column="2" Text="id,en" Height="34" Background="{DynamicResource BrushGatefoldSegmentBg}" BorderBrush="{DynamicResource BrushBorderDark}" Foreground="{DynamicResource BrushTextAccent}" FontSize="11" FontWeight="Bold" Padding="4,6" TextAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Section 4: Akselerasi & Fitur Tambahan (sec_opts) -->
                                <Border x:Name="SecOptsPanel" Background="{DynamicResource BrushGatefoldInner}" BorderBrush="{DynamicResource BrushGatefoldInnerBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="AKSELERASI &amp; FITUR TAMBAHAN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,8" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Opsi yang SELALU MUNCUL (Bahkan di Slide Mode) -->
                                            <CheckBox x:Name="CheckEmbedThumb" Grid.Row="0" Grid.Column="0" Content="Injeksi Thumbnail (Album Art)" IsChecked="True" Margin="0,5" />
                                            <CheckBox x:Name="CheckUseAria2" Grid.Row="0" Grid.Column="1" Content="Aria2c Multi-Thread (16x Speed)" IsChecked="True" Margin="0,5" />

                                            <!-- Opsi yang HANYA MUNCUL DI MODE VIDEO / AUDIO (DISEMBUNYIKAN DI SLIDE MODE) -->
                                            <CheckBox x:Name="CheckEmbedSubs" Grid.Row="1" Grid.Column="0" Content="Embed Softsub P0 (Default Aktif)" IsChecked="True" Margin="0,5" />
                                            <CheckBox x:Name="CheckDownloadSubs" Grid.Row="1" Grid.Column="1" Content="Unduh Subtitle Terpisah (.srt)" Margin="0,5" />
                                            <CheckBox x:Name="CheckPlaylist" Grid.Row="2" Grid.Column="0" Content="Unduh Full Playlist" Margin="0,5" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Section 5: Custom Command (sec_custom) -->
                                <Border Background="{DynamicResource BrushGatefoldInner}" BorderBrush="{DynamicResource BrushGatefoldInnerBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="ARGUMEN / PERINTAH CUSTOM (OPSIONAL):" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,6" />
                                        <TextBox x:Name="CustomCmdEntry" Height="36" Background="{DynamicResource BrushGatefoldSegmentBg}" BorderBrush="{DynamicResource BrushBorderDark}" Foreground="{DynamicResource BrushTextBody}" FontSize="11" Padding="12,8" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ════ TAB 2: ANTREAN BATCH (ui/queue_view.py) ════ -->
                <Grid x:Name="QueuePanel" Visibility="Collapsed">
                    <Border Background="{DynamicResource BrushCardBg}" CornerRadius="14" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="130" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Manajer Antrean Unduhan Massal (Batch Queue)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextTitle}" VerticalAlignment="Center" />
                                <Button Content="Kosongkan Antrean" Height="28" HorizontalAlignment="Right" Style="{StaticResource RoseButton}" Click="OnClearQueueClick" />
                            </Grid>

                            <TextBlock Grid.Row="1" Text="Tempelkan daftar URL (satu link per baris), lalu klik 'Tambahkan ke Antrean' dan 'Mulai Semua Unduhan'." FontSize="11" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,8" />

                            <!-- Queue Textbox -->
                            <TextBox x:Name="BatchUrlsInput" Grid.Row="2" Height="130" Background="{DynamicResource BrushCardInner}" BorderBrush="{DynamicResource BrushBorderDark}" Foreground="{DynamicResource BrushTextBody}" FontFamily="Consolas, monospace" FontSize="11" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" Padding="10" />

                            <!-- Buttons Row -->
                            <Grid Grid.Row="3" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Content="Tambahkan ke Antrean" Height="36" Style="{StaticResource IndigoButton}" Margin="0,0,8,0" Click="OnAddToQueueClick" />
                                    <Button x:Name="BtnStartQueue" Content="Mulai Semua Unduhan" Height="36" Style="{StaticResource EmeraldButton}" Click="OnStartQueueClick" />
                                </StackPanel>
                                <Button Content="Import File .txt" Height="36" HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Click="OnImportQueueTxtClick" />
                            </Grid>

                            <!-- Queue List Label -->
                            <TextBlock Grid.Row="4" Text="DAFTAR ANTREAN AKTIF" FontSize="10" FontWeight="Bold" Foreground="#4B5563" Margin="0,0,0,4" />

                            <!-- Queue List -->
                            <ListBox x:Name="QueueListBox" Grid.Row="5" Background="{DynamicResource BrushCardInner}" BorderBrush="{DynamicResource BrushBorderDark}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:QueueItem}">
                                        <Border Background="{DynamicResource BrushGatefoldInner}" BorderBrush="{DynamicResource BrushGatefoldInnerBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Url}" FontSize="10" Foreground="{DynamicResource BrushTextDim}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <ProgressBar Grid.Column="1" Height="6" Value="{Binding Progress}" Maximum="100" Background="{DynamicResource BrushGatefoldSegmentBg}" Foreground="{DynamicResource BrushAccentEmerald}" BorderThickness="0" VerticalAlignment="Center" Margin="12,0" />
                                                <Border Grid.Column="2" Style="{StaticResource PillBadge}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ════ TAB 3: RIWAYAT UNDUH (ui/history_view.py) ════ -->
                <Grid x:Name="HistoryPanel" Visibility="Collapsed">
                    <Border Background="{DynamicResource BrushCardBg}" CornerRadius="14" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Top Bar -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Riwayat Unduhan" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextTitle}" />
                                    <Border Background="{DynamicResource BrushNavActiveBg}" CornerRadius="6" Padding="8,3" Margin="10,0,0,0">
                                        <TextBlock x:Name="HistoryCountText" Text="0 Media" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushNavActiveFg}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Buka Folder Unduhan" Height="32" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnOpenFolderClick" />
                                    <Button Content="Bersihkan Riwayat" Height="32" Style="{StaticResource RoseButton}" Click="OnClearHistoryClick" />
                                </StackPanel>
                            </Grid>

                            <!-- Search Bar -->
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="HistorySearchInput" Height="36" Background="{DynamicResource BrushCardInner}" BorderBrush="{DynamicResource BrushBorderLight}" Foreground="{DynamicResource BrushTextTitle}" FontSize="12" Padding="12,8" TextChanged="OnHistorySearchChanged" />
                                <TextBlock x:Name="HistorySearchPlaceholder" Text="Cari riwayat berdasarkan judul atau platform..." Foreground="{DynamicResource BrushTextDim}" FontSize="12" Padding="14,10" VerticalAlignment="Center" IsHitTestVisible="False" />

                                <Button Grid.Column="1" Content="Reset" Width="60" Height="36" Margin="8,0,0,0" Style="{StaticResource GhostButton}" Click="OnResetSearchClick" />
                            </Grid>

                            <!-- History Cards List -->
                            <ListBox x:Name="HistoryListBox" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:HistoryItem}">
                                        <Border Background="{DynamicResource BrushCardInner}" CornerRadius="10" BorderBrush="{DynamicResource BrushBorderDark}" BorderThickness="1" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Thumbnail (Letterbox aspect fit, no crop/zoom) -->
                                                <Border Grid.Column="0" Width="110" Height="68" CornerRadius="6" Background="{DynamicResource BrushGatefoldSegmentBg}" ClipToBounds="True">
                                                    <Image Source="{Binding ThumbnailImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>

                                                <!-- Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextTitle}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Border Style="{StaticResource PillBadge}" Margin="0,0,6,0"><TextBlock Text="{Binding Platform}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextAccent}" /></Border>
                                                        <TextBlock Text="{Binding Resolution}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Duration}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Timestamp}" FontSize="11" Foreground="{DynamicResource BrushTextDim}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding FilePath}" FontSize="10" Foreground="{DynamicResource BrushTextDim}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Action Buttons -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{Binding PlayButtonLabel}" Style="{StaticResource IndigoButton}" Padding="14,6" Height="30" FontSize="11" Margin="0,0,6,0" Tag="{Binding FilePath}" Click="OnPlayHistoryItemClick" />
                                                    <Button Content="Folder" Style="{StaticResource GhostButton}" Padding="12,6" Height="30" FontSize="11" Margin="0,0,6,0" Tag="{Binding FilePath}" Click="OnOpenHistoryFolderClick" />
                                                    <Button Content="Hapus" Style="{StaticResource RoseButton}" Padding="10,6" Height="30" FontSize="11" Tag="{Binding Id}" Click="OnDeleteHistoryItemClick" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ════ TAB 4: KONSOL LOG (ui/log_view.py) ════ -->
                <Grid x:Name="LogPanel" Visibility="Collapsed">
                    <Border Background="{DynamicResource BrushCardBg}" CornerRadius="14" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Konsol Terminal &amp; Output Eksekusi" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextTitle}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Salin Semua" Height="28" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="OnCopyLogClick" />
                                    <Button Content="Bersihkan Log" Height="28" Style="{StaticResource GhostButton}" Click="OnClearLogClick" />
                                </StackPanel>
                            </Grid>

                            <TextBox x:Name="LogConsoleFull" Grid.Row="1" Background="{DynamicResource BrushGatefoldSegmentBg}" BorderBrush="{DynamicResource BrushBorderDark}" Foreground="{DynamicResource BrushTextBody}" FontFamily="Consolas, monospace" FontSize="11" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="12" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- ════ TAB 5: PENGATURAN (ui/settings_view.py) ════ -->
                <!-- ════ TAB 5: PENGATURAN (ui/settings_view.py) ════ -->
                <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                    <Border Background="{DynamicResource BrushCardBg}" CornerRadius="14" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,16,24">
                                <!-- Header -->
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="Pengaturan &amp; Tentang" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextTitle}" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource BrushNavActiveBg}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                        <TextBlock Text="v1.3.0" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushNavActiveFg}" />
                                    </Border>
                                </Grid>

                                <!-- Section 1: Folder Output -->
                                <Border Background="{DynamicResource BrushCardInner}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="FOLDER PENYIMPANAN UTAMA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,6" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="SettingsPathBox" Background="{DynamicResource BrushGatefoldSegmentBg}" BorderBrush="{DynamicResource BrushBorderDark}" Foreground="{DynamicResource BrushTextBody}" FontSize="11" Height="36" Padding="10,8" IsReadOnly="True" />
                                            <Button Grid.Column="1" Content="Pilih Folder" Width="100" Height="36" Style="{StaticResource IndigoButton}" Margin="8,0,0,0" Click="OnSelectFolderClick" />
                                            <Button Grid.Column="2" Content="Buka" Width="60" Height="36" Style="{StaticResource GhostButton}" Margin="4,0,0,0" Click="OnOpenFolderClick" />
                                        </Grid>
                                        <CheckBox x:Name="CheckOrganizePlatform" Content="Kelompokkan unduhan ke folder platform (Mavdown_YouTube, Mavdown_Douyin, dll.)" Foreground="{DynamicResource BrushTextBody}" FontSize="11" IsChecked="True" Click="OnOrganizePlatformChanged" />
                                    </StackPanel>
                                </Border>

                                <!-- Section 2: Pemantau Papan Klip (Auto-Detect Clipboard) -->
                                <Border Background="{DynamicResource BrushCardInner}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="PEMANTAU PAPAN KLIP (AUTO-DETECT CLIPBOARD)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,6" />
                                        <TextBlock Text="Otomatis mendeteksi tautan media saat disalin di browser dan memuatnya langsung ke Studio." FontSize="10" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,8" />
                                        <CheckBox x:Name="CheckClipboardMonitor" Content="Aktifkan Pemantauan Otomatis Papan Klip (Auto Clipboard)" Foreground="{DynamicResource BrushTextBody}" FontSize="11" Checked="OnClipboardMonitorChanged" Unchecked="OnClipboardMonitorChanged" />
                                    </StackPanel>
                                </Border>

                                <!-- Section 3: Tema & Palet Warna Adaptif (Gatefold Cover Palette Engine) -->
                                <Border Background="{DynamicResource BrushCardInner}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="WARNA &amp; PALET TEMA (GATEFOLD COVER-ADAPTIVE)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,6" />
                                        <TextBlock Text="Tema antarmuka beradaptasi secara otomatis mengikuti palet warna thumbnail media (OKLab &amp; k-means clustering)." FontSize="10" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,10" />

                                        <Border Background="{DynamicResource BrushGatefoldSegmentBg}" BorderBrush="{DynamicResource BrushBorderDark}" BorderThickness="1" CornerRadius="8" Padding="2" Height="36" Margin="0,0,0,10">
                                            <UniformGrid Rows="1" Columns="3">
                                                <RadioButton x:Name="RadioThemeDarkAdaptive" Content="Dark Adaptif" IsChecked="True" Style="{StaticResource SegmentRadioButton}" GroupName="GroupThemeMode" Checked="OnThemeModeChanged" />
                                                <RadioButton x:Name="RadioThemeFullAuto" Content="Otomatis Dinamis" Style="{StaticResource SegmentRadioButton}" GroupName="GroupThemeMode" Checked="OnThemeModeChanged" />
                                                <RadioButton x:Name="RadioThemeStatic" Content="Dark Statis" Style="{StaticResource SegmentRadioButton}" GroupName="GroupThemeMode" Checked="OnThemeModeChanged" />
                                            </UniformGrid>
                                        </Border>

                                        <TextBlock Text="PALET WARNA COVER SAAT INI:" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,6" />
                                        <WrapPanel x:Name="CoverPaletteSwatchesPanel" Margin="0,0,0,2">
                                            <TextBlock Text="Belum ada thumbnail media yang dimuat." FontSize="11" Foreground="{DynamicResource BrushTextDim}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Section 4: Browser Cookie -->
                                <Border Background="{DynamicResource BrushCardInner}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="COOKIE BROWSER (UNTUK KONTEN PRIVATE / LOGIN)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,6" />
                                        <ComboBox x:Name="ComboBrowserCookie" FontSize="11" Height="34" Width="260" HorizontalAlignment="Left" SelectionChanged="OnBrowserCookieChanged">
                                            <ComboBoxItem Content="Tidak Ada" IsSelected="True" />
                                            <ComboBoxItem Content="Chrome" />
                                            <ComboBoxItem Content="Edge" />
                                            <ComboBoxItem Content="Firefox" />
                                            <ComboBoxItem Content="Brave" />
                                            <ComboBoxItem Content="Opera" />
                                            <ComboBoxItem Content="Vivaldi" />
                                        </ComboBox>
                                        <TextBlock Text="Gunakan cookie dari browser jika media YouTube/Bilibili dibatasi usia atau login." FontSize="10" Foreground="{DynamicResource BrushTextDim}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Section 4: Jaringan & Proxy -->
                                <Border Background="{DynamicResource BrushCardInner}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="JARINGAN &amp; PROXY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,6" />
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="SettingsProxyBox" Background="{DynamicResource BrushGatefoldSegmentBg}" BorderBrush="{DynamicResource BrushBorderDark}" Foreground="{DynamicResource BrushTextBody}" FontSize="11" Height="34" Padding="10,6" />
                                            <Button Grid.Column="1" Content="Simpan Proxy" Width="100" Height="34" Style="{StaticResource IndigoButton}" Margin="8,0,0,0" Click="OnSaveProxyClick" />
                                        </Grid>
                                        <TextBlock Text="Contoh: http://127.0.0.1:7890 atau socks5://127.0.0.1:1080 (Kosongkan jika tidak menggunakan proxy)." FontSize="10" Foreground="{DynamicResource BrushTextDim}" />
                                    </StackPanel>
                                </Border>

                                <!-- Section 5: Akun & Sesi Pixiv -->
                                <Border Background="{DynamicResource BrushCardInner}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="SESI AKUN PIXIV (AKSES KONTEN RESTRICTED &amp; R-18)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,6" />
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="SettingsPixivBox" Background="{DynamicResource BrushGatefoldSegmentBg}" BorderBrush="{DynamicResource BrushBorderDark}" Foreground="{DynamicResource BrushTextBody}" FontSize="11" Height="36" Padding="10,8" />
                                            <Button x:Name="BtnTogglePixivMask" Grid.Column="1" Content="Lihat" Width="64" Height="36" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="OnTogglePixivMaskClick" />
                                            <Button x:Name="BtnSavePixivSession" Grid.Column="2" Content="Simpan &amp; Cek" Width="100" Height="36" Style="{StaticResource IndigoButton}" Margin="6,0,0,0" Click="OnSavePixivSessionClick" />
                                            <Button x:Name="BtnLoginBrowserPixiv" Grid.Column="3" Content="Login Browser" Width="110" Height="36" Style="{StaticResource EmeraldButton}" Margin="6,0,0,0" Click="OnLoginBrowserPixivClick" />
                                            <Button x:Name="BtnClearPixivSession" Grid.Column="4" Content="Hapus" Width="60" Height="36" Style="{StaticResource RoseButton}" Margin="6,0,0,0" Click="OnClearPixivSessionClick" />
                                        </Grid>
                                        <TextBlock x:Name="TxtPixivStatus" Text="Status: Belum Terhubung (Sesi Kosong)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="0,2,0,4" />
                                        <TextBlock Text="Diperlukan untuk membuka karya R-18, R-18G, atau members-only. Anda dapat mengklik tombol 'Login Browser' untuk masuk secara langsung via browser Mavdown, atau menempelkan nilai PHPSESSID secara manual. Sesi disimpan secara lokal tanpa menyimpan email atau kata sandi." FontSize="10" Foreground="{DynamicResource BrushTextDim}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Section 6: Biner & Update -->
                                <Border Background="{DynamicResource BrushCardInner}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="PEMBARUAN KOMPONEN YT-DLP" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,6" />
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="ComboYtdlpChannel" FontSize="11" Height="34">
                                                <ComboBoxItem Content="Stable (Direkomendasikan)" IsSelected="True" />
                                                <ComboBoxItem Content="Nightly (Rilis Terkini)" />
                                            </ComboBox>
                                            <Button Grid.Column="1" Content="Perbarui yt-dlp Sekarang" Height="34" Style="{StaticResource AmberButton}" Margin="10,0,0,0" Click="OnUpdateYtdlpClick" />
                                        </Grid>
                                        <TextBlock x:Name="YtdlpVersionText" Text="Versi yt-dlp: Memeriksa..." FontSize="10" Foreground="{DynamicResource BrushTextDim}" />
                                    </StackPanel>
                                </Border>

                                <!-- Section 7: Info Sistem & Dependensi -->
                                <Border Background="{DynamicResource BrushCardInner}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="INFORMASI SISTEM &amp; STATUS DEPENDENSI" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource BrushGatefoldSegmentBg}" BorderBrush="{DynamicResource BrushBorderDark}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="Aria2c Multi-Thread" FontSize="10" Foreground="{DynamicResource BrushTextDim}" />
                                                    <TextBlock x:Name="TxtStatusAria2" Text="Tersedia (16x)" FontSize="11" FontWeight="Bold" Foreground="#34D399" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="{DynamicResource BrushGatefoldSegmentBg}" BorderBrush="{DynamicResource BrushBorderDark}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="2,0,2,0">
                                                <StackPanel>
                                                    <TextBlock Text="FFmpeg Codec" FontSize="10" Foreground="{DynamicResource BrushTextDim}" />
                                                    <TextBlock x:Name="TxtStatusFfmpeg" Text="Aktif" FontSize="11" FontWeight="Bold" Foreground="#34D399" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{DynamicResource BrushGatefoldSegmentBg}" BorderBrush="{DynamicResource BrushBorderDark}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="2,0,2,0">
                                                <StackPanel>
                                                    <TextBlock Text="Node.js Engine" FontSize="10" Foreground="{DynamicResource BrushTextDim}" />
                                                    <TextBlock x:Name="TxtStatusNode" Text="Aktif (Anti-403)" FontSize="11" FontWeight="Bold" Foreground="#34D399" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="3" Background="{DynamicResource BrushGatefoldSegmentBg}" BorderBrush="{DynamicResource BrushBorderDark}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Python IPC Daemon" FontSize="10" Foreground="{DynamicResource BrushTextDim}" />
                                                    <TextBlock x:Name="TxtStatusIpc" Text="Terhubung" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentIndigo}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Section 8: Tentang Proyek & Lisensi (Tkinter Parity) -->
                                <Border Background="{DynamicResource BrushCardInner}" CornerRadius="10" Padding="14,14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="TENTANG PROYEK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,10" />

                                        <!-- Brand Row -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="48" Height="48" CornerRadius="8" Background="{DynamicResource BrushGatefoldSegmentBg}" ClipToBounds="True" Margin="0,0,14,0">
                                                <Image x:Name="SettingsLogoImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Maven Downloader (Mavdown)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextTitle}" />
                                                <TextBlock Text="Versi v1.3.0  --  Multi-Tier Engine Architecture" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" />
                                                <TextBlock Text="Dikembangkan oleh SayMaven" FontSize="11" Foreground="{DynamicResource BrushTextDim}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Divider -->
                                        <Border Height="1" Background="{DynamicResource BrushBorderDark}" Margin="0,4,0,10" />

                                        <!-- Info Grid -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Repositori:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="github.com/SayMaven/mavdown" FontSize="11" Foreground="{DynamicResource BrushTextBody}" Margin="0,2" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Lisensi:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="MIT License -- Copyright (c) 2026 SayMaven" FontSize="11" Foreground="{DynamicResource BrushTextBody}" Margin="0,2" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Engine Tier 1:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="REST Scraper (TikTok, Douyin, Instagram, Twitter/X, Pinterest, Facebook, Bilibili)" FontSize="11" Foreground="{DynamicResource BrushTextBody}" TextWrapping="Wrap" Margin="0,2" />

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Engine Tier 2:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="yt-dlp + aria2c + ffmpeg + node.js anti-bot solver" FontSize="11" Foreground="{DynamicResource BrushTextBody}" Margin="0,2" />

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Framework UI:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="WPF / C# (.NET 10.0 Native Studio)" FontSize="11" Foreground="{DynamicResource BrushTextBody}" Margin="0,2" />

                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Akselerator:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2" />
                                            <TextBlock x:Name="TxtInfoAria2" Grid.Row="5" Grid.Column="1" Text="aria2c 16-thread (Tersedia)" FontSize="11" Foreground="{DynamicResource BrushTextBody}" Margin="0,2" />
                                        </Grid>

                                        <!-- Divider -->
                                        <Border Height="1" Background="{DynamicResource BrushBorderDark}" Margin="0,8,0,10" />

                                        <!-- Action Buttons -->
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Buka GitHub Repository" Width="180" Height="32" Style="{StaticResource GhostButton}" Foreground="{DynamicResource BrushTextAccent}" FontWeight="Bold" Margin="0,0,8,0" Click="OnOpenGitHubRepoClick" />
                                            <Button Content="Laporkan Bug" Width="120" Height="32" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnReportBugClick" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

            </Grid>

            <!-- ── Bottom Live Progress & Telemetry Dock (Persistent, Gatefold Player Style) ── -->
            <Border x:Name="BottomProgressDock" Grid.Row="2" Background="{DynamicResource BrushGatefoldCardBg}" BorderBrush="{DynamicResource BrushGatefoldBorder}" BorderThickness="1" CornerRadius="14" Margin="0,12,0,0" Padding="18,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.4" />
                </Border.Effect>
                <Grid>
                    <Rectangle IsHitTestVisible="False" Fill="{DynamicResource BrushNoiseOverlay}" Margin="-18,-12" />
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="ProgressStatusText" Text="Status: Siap Mengunduh" FontSize="12" FontWeight="Bold" Foreground="#F3F4F6" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="ProgressStatsText" Text="" FontFamily="Consolas, monospace" FontSize="11" Foreground="{DynamicResource BrushAccentIndigo}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Border CornerRadius="4" Height="6" Background="{DynamicResource BrushGatefoldSegmentBg}" BorderBrush="{DynamicResource BrushBorderDark}" BorderThickness="1" ClipToBounds="True">
                            <ProgressBar x:Name="DownloadProgressBar" Height="6" Value="0" Maximum="100" Background="Transparent" Foreground="{DynamicResource BrushAccentEmerald}" BorderThickness="0" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- Floating Toast Notification (Identical to Tkinter show_toast)   -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border x:Name="ToastCard"
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,24,65"
                MinWidth="320"
                MaxWidth="440"
                CornerRadius="8"
                Padding="16,12"
                Opacity="0"
                Visibility="Collapsed"
                Panel.ZIndex="1000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.5" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ToastText"
                           Foreground="White"
                           FontSize="12"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="X"
                        Width="22"
                        Height="22"
                        Foreground="White"
                        Opacity="0.8"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="10"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Click="OnDismissToastClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
